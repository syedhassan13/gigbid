# Copy to .env and fill in. NEVER commit .env.
# --- models (open profile = Groq hosted open-weight models) ---
GIGBID_PROFILE=open                 # open | open_alt | local | paid | offline
GROQ_API_KEY=
OPENROUTER_API_KEY=                 # only for the optional "paid" profile
# --- app ---
JWT_SECRET=change-me-long-random
TOKEN_ENC_KEY=                      # Fernet key: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
REVIEWER_EMAIL=
REVIEWER_PASSWORD=
CORS_ORIGINS=http://localhost:5173
WEB_URL=http://localhost:5173
# --- infra (docker compose sets these) ---
DATABASE_URL=                       # postgresql://gigbid:gigbid@postgres:5432/gigbid ; empty = SQLite in var/
REDIS_URL=                          # redis://redis:6379 ; empty = embedded worker in the API process
MCP_TRANSPORT=inproc                # inproc | http
PORTFOLIO_MCP_URL=http://portfolio-mcp:8201/mcp
MARKETPLACE_MCP_URL=http://marketplace-mcp:8202/mcp
WORKSPACE_MCP_URL=http://workspace-mcp:8203/mcp
GIGSIM_URL=http://gigsim:8100
GIGSIM_AUTOTICK_SECONDS=30
GIGSIM_TOKEN_AI_ML=
GIGSIM_TOKEN_FULLSTACK=
GIGSIM_TOKEN_DATA_ANALYST=
MARKETPLACE_RATE_PER_MIN=60
# --- live Upwork (optional; never graded) ---
UPWORK_MCP_URL=https://mcp.upwork.com/mcp
UPWORK_CLIENT_ID=
# --- tracing (optional) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=gigbid
