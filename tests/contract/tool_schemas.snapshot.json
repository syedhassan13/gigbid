{
 "gigbid-marketplace.create_proposal_draft": {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": false,
   "readOnlyHint": false
  },
  "input": {
   "$defs": {
    "ProposalDraftIn": {
     "properties": {
      "bid_amount": {
       "description": "USD; hourly rate for hourly jobs, total for fixed",
       "exclusiveMinimum": 0,
       "maximum": 100000,
       "title": "Bid Amount",
       "type": "number"
      },
      "cover_letter": {
       "maxLength": 5000,
       "minLength": 50,
       "title": "Cover Letter",
       "type": "string"
      },
      "job_id": {
       "maxLength": 64,
       "minLength": 3,
       "title": "Job Id",
       "type": "string"
      },
      "screening_answers": {
       "items": {
        "maxLength": 2000,
        "type": "string"
       },
       "maxItems": 10,
       "title": "Screening Answers",
       "type": "array"
      },
      "variant": {
       "anyOf": [
        {
         "maxLength": 20,
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "description": "X2 experiment arm",
       "title": "Variant"
      }
     },
     "required": [
      "job_id",
      "cover_letter",
      "bid_amount"
     ],
     "title": "ProposalDraftIn",
     "type": "object"
    }
   },
   "properties": {
    "draft": {
     "$ref": "#/$defs/ProposalDraftIn"
    },
    "idempotency_key": {
     "maxLength": 128,
     "minLength": 8,
     "title": "Idempotency Key",
     "type": "string"
    }
   },
   "required": [
    "draft",
    "idempotency_key"
   ],
   "title": "create_proposal_draftArguments",
   "type": "object"
  },
  "output": {
   "properties": {
    "draft_id": {
     "title": "Draft Id",
     "type": "string"
    },
    "preview": {
     "additionalProperties": true,
     "description": "Exactly what would be sent, the Connects cost and policy violations",
     "title": "Preview",
     "type": "object"
    }
   },
   "required": [
    "draft_id",
    "preview"
   ],
   "title": "DraftOut",
   "type": "object"
  }
 },
